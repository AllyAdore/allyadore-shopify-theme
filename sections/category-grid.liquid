<section class="category-grid">
  <div class="container">
    <div class="categories">
      <!-- Best Sellers Category -->
      <div class="category-card">
        <a href="/collections/best-sellers" class="category-link-wrapper">
          <div class="category-image">
            {% if section.settings.category_1_image %}
              <img src="{{ section.settings.category_1_image | img_url: '400x300' }}" alt="Best Sellers" />
            {% else %}
              <div class="category-placeholder">Best Sellers</div>
            {% endif %}
          </div>
          <h3 class="category-title">Best Sellers</h3>
          <span class="category-link">Shop All →</span>
        </a>
      </div>

      <!-- Fragrances for Her Category -->
      <div class="category-card">
        <a href="/collections/fragrances-for-her" class="category-link-wrapper">
          <div class="category-image">
            {% if section.settings.category_2_image %}
              <img src="{{ section.settings.category_2_image | img_url: '400x300' }}" alt="Fragrances for Her" />
            {% else %}
              <div class="category-placeholder">Fragrances for Her</div>
            {% endif %}
          </div>
          <h3 class="category-title">Fragrances for Her</h3>
          <span class="category-link">Shop All →</span>
        </a>
      </div>

      <!-- Fragrances for Him Category -->
      <div class="category-card">
        <a href="/collections/fragrances-for-him" class="category-link-wrapper">
          <div class="category-image">
            {% if section.settings.category_3_image %}
              <img src="{{ section.settings.category_3_image | img_url: '400x300' }}" alt="Fragrances for Him" />
            {% else %}
              <div class="category-placeholder">Fragrances for Him</div>
            {% endif %}
          </div>
          <h3 class="category-title">Fragrances for Him</h3>
          <span class="category-link">Shop All →</span>
        </a>
      </div>

      <!-- Mists & Lotions Category -->
      <div class="category-card">
        <a href="/collections/mists-and-lotions" class="category-link-wrapper">
          <div class="category-image">
            {% if section.settings.category_4_image %}
              <img src="{{ section.settings.category_4_image | img_url: '400x300' }}" alt="Mists & Lotions" />
            {% else %}
              <div class="category-placeholder">Mists & Lotions</div>
            {% endif %}
          </div>
          <h3 class="category-title">Mists & Lotions</h3>
          <span class="category-link">Shop All →</span>
        </a>
      </div>

      <!-- Bath & Body Category -->
      <div class="category-card">
        <a href="/collections/bath-and-body" class="category-link-wrapper">
          <div class="category-image">
            {% if section.settings.category_5_image %}
              <img src="{{ section.settings.category_5_image | img_url: '400x300' }}" alt="Bath & Body" />
            {% else %}
              <div class="category-placeholder">Bath & Body</div>
            {% endif %}
          </div>
          <h3 class="category-title">Bath & Body</h3>
          <span class="category-link">Shop All →</span>
        </a>
      </div>

      <!-- Gift Sets Category -->
      <div class="category-card">
        <a href="/collections/gift-sets" class="category-link-wrapper">
          <div class="category-image">
            {% if section.settings.category_6_image %}
              <img src="{{ section.settings.category_6_image | img_url: '400x300' }}" alt="Gift Sets" />
            {% else %}
              <div class="category-placeholder">Gift Sets</div>
            {% endif %}
          </div>
          <h3 class="category-title">Gift Sets</h3>
          <span class="category-link">Shop All →</span>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Grid",
  "settings": [
    {
      "type": "image_picker",
      "id": "category_1_image",
      "label": "Best Sellers Image"
    },
    {
      "type": "image_picker",
      "id": "category_2_image",
      "label": "Fragrances for Her Image"
    },
    {
      "type": "image_picker",
      "id": "category_3_image",
      "label": "Fragrances for Him Image"
    },
    {
      "type": "image_picker",
      "id": "category_4_image",
      "label": "Mists & Lotions Image"
    },
    {
      "type": "image_picker",
      "id": "category_5_image",
      "label": "Bath & Body Image"
    },
    {
      "type": "image_picker",
      "id": "category_6_image",
      "label": "Gift Sets Image"
    }
  ]
}
{% endschema %}
