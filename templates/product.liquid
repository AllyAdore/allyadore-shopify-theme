<div class="container product-page">
  <div class="product-gallery">
    {% if product.featured_image %}
      <img src="{{ product.featured_image | img_url: '600x600' }}" alt="{{ product.title }}" />
    {% endif %}
  </div>
  
  <div class="product-details">
    <h1>{{ product.title }}</h1>
    <p class="product-vendor">By {{ product.vendor }}</p>
    <p class="product-price">{{ product.price | money }}</p>
    
    <div class="product-description">
      {{ product.description }}
    </div>
    
    {% form 'product' %}
      {% if product.variants.size > 1 %}
        <div class="variant-selector">
          <label for="variant-select">Choose an option:</label>
          <select id="variant-select" name="id">
            {% for variant in product.variants %}
              <option value="{{ variant.id }}">{{ variant.title }}</option>
            {% endfor %}
          </select>
        </div>
      {% endif %}
      
      <div class="quantity-selector">
        <label for="quantity">Quantity:</label>
        <input type="number" id="quantity" name="quantity" value="1" min="1" />
      </div>
      
      <button type="submit" class="btn btn-primary btn-large">Add to Cart</button>
    {% endform %}
  </div>
</div>
